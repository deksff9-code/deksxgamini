<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cuban Mods — Free Fire Max</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  :root{--bg:#0a0a0f;--panel:#12121a;--line:#1f1f2e;--accent:#00ff9c;--accent2:#ff2d6f;--text:#e6e6f0;--dim:#7a7a92}
  body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
  a{color:var(--accent);text-decoration:none}
  .wrap{max-width:1000px;margin:0 auto;padding:0 20px}

  /* HERO */
  header{padding:80px 0 60px;text-align:center;position:relative;overflow:hidden}
  header::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(0,255,156,.12),transparent 60%);pointer-events:none}
  .tag{display:inline-block;font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);border:1px solid var(--accent);padding:6px 14px;border-radius:99px;margin-bottom:20px}
  h1{font-size:clamp(2rem,6vw,3.5rem);font-weight:800;letter-spacing:-.02em}
  h1 span{background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent}
  .sub{color:var(--dim);max-width:560px;margin:16px auto 0}

  /* GRID */
  section{padding:60px 0}
  .sec-title{font-size:.8rem;letter-spacing:.25em;text-transform:uppercase;color:var(--dim);margin-bottom:24px;display:flex;align-items:center;gap:12px}
  .sec-title::after{content:"";flex:1;height:1px;background:var(--line)}

  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:24px;transition:.2s}
  .card:hover{border-color:var(--accent);transform:translateY(-3px)}
  .card h3{font-size:1.05rem;margin-bottom:8px}
  .card p{color:var(--dim);font-size:.9rem}
  .card .ico{font-size:1.6rem;margin-bottom:12px}

  /* GENERATOR */
  .gen{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:32px;max-width:620px;margin:0 auto}
  .gen label{display:block;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);margin-bottom:8px}
  .gen select,.gen input{width:100%;padding:12px 14px;background:var(--bg);border:1px solid var(--line);border-radius:8px;color:var(--text);font-size:1rem;margin-bottom:18px;outline:none}
  .gen select:focus,.gen input:focus{border-color:var(--accent)}
  .btn{width:100%;padding:14px;background:var(--accent);color:#000;border:none;border-radius:8px;font-size:1rem;font-weight:700;letter-spacing:.05em;cursor:pointer;transition:.15s}
  .btn:hover{filter:brightness(1.15)}
  .btn:active{transform:scale(.98)}
  .out{margin-top:20px;background:var(--bg);border:1px dashed var(--line);border-radius:8px;padding:18px;font-family:'Courier New',monospace;font-size:1.1rem;letter-spacing:.1em;text-align:center;color:var(--accent);min-height:58px;display:flex;align-items:center;justify-content:center;word-break:break-all}
  .note{font-size:.75rem;color:var(--dim);text-align:center;margin-top:14px}

  /* STATS */
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:16px;text-align:center}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:24px}
  .stat b{display:block;font-size:1.8rem;color:var(--accent)}
  .stat span{font-size:.8rem;color:var(--dim);text-transform:uppercase;letter-spacing:.1em}

  footer{border-top:1px solid var(--line);padding:32px 0;text-align:center;color:var(--dim);font-size:.85rem}
</style>
</head>
<body>

<header>
  <div class="wrap">
    <span class="tag">Free Fire Max · Mods</span>
    <h1>Cuban <span>Mods</span></h1>
    <p class="sub">Portofolio mod, preset, dan panel key generator. Dibangun untuk kecepatan dan presisi.</p>
  </div>
</header>

<section>
  <div class="wrap">
    <div class="sec-title">Portofolio</div>
    <div class="cards">
      <div class="card"><div class="ico">🎯</div><h3>Aim Preset Pack</h3><p>Kurva sensitivitas & drag headshot untuk semua device tier.</p></div>
      <div class="card"><div class="ico">⚙️</div><h3>Config Optimizer</h3><p>Set GFX, DPI, dan frame lock stabil 90fps di device mid-range.</p></div>
      <div class="card"><div class="ico">🎨</div><h3>HUD Theme Set</h3><p>Crosshair, tombol, dan layout custom yang bersih dan low-clutter.</p></div>
      <div class="card"><div class="ico">🔑</div><h3>Key Panel</h3><p>Generator key client-side dengan format per-tier di bawah.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-title">Key Generator</div>
    <div class="gen">
      <label for="tier">Tier</label>
      <select id="tier">
        <option value="BASIC">BASIC</option>
        <option value="PRO">PRO</option>
        <option value="ELITE">ELITE</option>
        <option value="LIFETIME">LIFETIME</option>
      </select>

      <label for="user">Username / ID</label>
      <input id="user" type="text" placeholder="contoh: cuban666" maxlength="16" autocomplete="off">

      <button class="btn" onclick="genKey()">Generate Key</button>

      <div class="out" id="out">— — — —</div>
      <p class="note">Key digenerate lokal di browser. Tidak dikirim ke server mana pun.</p>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="stats">
      <div class="stat"><b id="s1">0</b><span>Key Dibuat</span></div>
      <div class="stat"><b>4</b><span>Tier</span></div>
      <div class="stat"><b>100%</b><span>Client-side</span></div>
      <div class="stat"><b>0ms</b><span>Latency</span></div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">Cuban Mods · Portfolio & Key Panel · <span id="yr"></span></div>
</footer>

<script>
  document.getElementById('yr').textContent = new Date().getFullYear();

  const ALPH = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const countEl = document.getElementById('s1');
  let count = 0;

  function rnd(n) {
    const a = new Uint8Array(n);
    crypto.getRandomValues(a);
    return Array.from(a, b => ALPH[b % ALPH.length]).join('');
  }

  function checksum(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) >>> 0;
    return ALPH[h % ALPH.length] + ALPH[(h >> 5) % ALPH.length];
  }

  function genKey() {
    const tier = document.getElementById('tier').value;
    const user = (document.getElementById('user').value || 'GUEST').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6) || 'GUEST';

    const body = rnd(4) + '-' + rnd(4) + '-' + rnd(4);
    const raw = tier[0] + user + body.replace(/-/g, '');
    const key = `${tier[0]}${user.slice(0, 3)}-${body}-${checksum(raw)}`;

    document.getElementById('out').textContent = key;
    countEl.textContent = ++count;
    navigator.clipboard?.writeText(key).catch(() => {});
  }
</script>
</body>
</html>
